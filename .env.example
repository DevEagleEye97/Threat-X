# ============================================================
# THREATX ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env.local and populate with your actual keys.
# DO NOT commit .env or .env.local with real secrets to version control.

# AI Reasoning Provider (OpenRouter or Google Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Threat Intelligence Providers (Optional - Mock providers are used if unset)
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
PHISHTANK_API_KEY=your_phishtank_api_key_here

# Node Environment
NODE_ENV=development
